# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Where this service is reachable from the internet (Razorpay sends customers back here)
PUBLIC_BASE_URL=http://localhost:8080

# Postgres, as a JDBC URL plus credentials. Neon example:
#   DATABASE_URL=jdbc:postgresql://ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/payments
DATABASE_USERNAME=payments
DATABASE_PASSWORD=payments

# Razorpay dashboard (Test Mode) -> Settings -> API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Razorpay dashboard -> Settings -> Webhooks -> the secret you set for this service's webhook
RAZORPAY_WEBHOOK_SECRET=

# Checkouts expire after this long (Razorpay needs at least 16 minutes)
CHECKOUT_EXPIRY=30m

# One block per website that may use this service (index 0, 1, 2, ...).
# API key: any long random string you give the website, e.g. `openssl rand -hex 32`.
# Only its SHA-256 goes here:        printf %s "$API_KEY" | sha256sum
PAYMENTS_SITES_0_ID=portfolio
PAYMENTS_SITES_0_API_KEY_SHA256=
# Where to send signed checkout.* webhooks (optional), and the secret the website verifies them with
PAYMENTS_SITES_0_WEBHOOK_URL=https://example.com/api/payments/webhook
PAYMENTS_SITES_0_WEBHOOK_SECRET=
# success_url / cancel_url must be on one of these origins
PAYMENTS_SITES_0_ALLOWED_REDIRECT_ORIGINS_0=https://example.com
PAYMENTS_SITES_0_ALLOWED_REDIRECT_ORIGINS_1=http://localhost:3000
